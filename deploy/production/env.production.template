# ePULSE v1.0.0 — PRODUCTION settings (office apps server)
# Copy this file to  backend\.env  and fill every <...>. Never commit backend\.env.

# ── This server's PostgreSQL (the ePULSE database itself) ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ePULSE_v1.0.0
DB_USER=postgres
DB_PASSWORD=<postgres password of THIS server>

# ── Office PIMS server (the production twin of PC-2) — read live, nothing copied ──
# Used by step2_link_pims_server.bat (db\linkPc2.js); run it again if the address or password changes.
EMP_DB_HOST=<IP of the office PIMS server>
EMP_DB_PORT=5432
EMP_DB_NAME=eil_employees
EMP_DB_USER=postgres
EMP_DB_PASSWORD=<postgres password of the PIMS server>

PIMS_DB_HOST=<IP of the office PIMS server>
PIMS_DB_PORT=5432
PIMS_DB_NAME=cmp_pims_1014
PIMS_DB_USER=postgres
PIMS_DB_PASSWORD=<postgres password of the PIMS server>

# ── Web server ──
PORT=3300
NODE_ENV=production

# Session cookie signing — any long random text, NEW for production (not the development one).
# Make one with:  backend\node-v22.19.0-win-x64\node.exe -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<64 random hex characters>

# Single sign-on with the other modules (MRCS, SSMS, IPMCS) — at least 32 characters.
# Create it once for production; every production module must later use the SAME value.
SSO_SECRET=<64 random hex characters, shared by all production modules>
