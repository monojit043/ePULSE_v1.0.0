# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pims_db
DB_USER=postgres
DB_PASSWORD=

# Live links to PC-2 (postgres_fdw) — nothing is copied; ePULSE reads these DBs on every query.
# Used only by `npm run db:link-pc2` (run once per machine, and again if host/password changes).
# Leave a *_PASSWORD blank to take it from %APPDATA%\postgresql\pgpass.conf
# Employee master DB — login credentials
EMP_DB_HOST=10.63.39.168
EMP_DB_PORT=5432
EMP_DB_NAME=eil_employees
EMP_DB_USER=postgres
EMP_DB_PASSWORD=

# PIMS DB — projects, units, SGLs, role assignments
PIMS_DB_HOST=10.63.39.168
PIMS_DB_PORT=5432
PIMS_DB_NAME=cmp_pims_1014
PIMS_DB_USER=postgres
PIMS_DB_PASSWORD=

# Express session
SESSION_SECRET=

# Server
PORT=3000
NODE_ENV=development

# Single sign-on across ePULSE / MRCS — MUST be identical in every app (min 32 chars)
SSO_SECRET=
